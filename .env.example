# Copy to .env.local for local development, and set the same two variables
# in the Vercel project (Settings → Environment Variables).
#
# Only the public anon/publishable key belongs here.
# NEVER put the service_role key in a VITE_* variable — it is bundled into
# the browser build and would give anyone full database access.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
